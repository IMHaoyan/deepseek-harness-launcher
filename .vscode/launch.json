{
  // VS Code 调试配置：Ctrl+Shift+D → 选目标 → F5（详见 README「IDE 调试（VS Code）」）
  // F5 运行的是当前 workspace 的源码，不会运行 dist\dshl-*.exe 或已安装版。
  // 开发配置使用独立的 .dev-user-data，避免与已安装版共用 Electron 单实例锁；DSH_HOME 仍按默认指向真实 ~/.dsh。
  // 为避免两个启动器同时管理同一 DSH 服务/托盘，F5 前建议先托盘退出已安装版。
  // 要验证打包产物，请直接运行 dist\win-unpacked\DeepSeek Harness Launcher.exe 或安装 dist\dshl-*.exe。
  "version": "0.2.0",
  "configurations": [
    {
      // 最常用：主进程断点调试（main.js / console-surface.js / updater.js…），启动后直接打开 DSHL 控制台
      "name": "启动器：主进程调试（当前源码）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
      "args": [".", "--console", "--user-data-dir=${workspaceFolder}/.dev-user-data"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      // 开发期诊断开关：服务启停的防重入日志（含调用栈）写进 dshl.log，便于定位"停止被忽略"类问题
      "env": { "DSHL_DEBUG_STOP": "1" },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      // 主进程 + 渲染进程一起调试：先 F5 这个，再运行「附加到控制台渲染进程（9222）」
      "name": "启动器：主进程 + 渲染进程调试（当前源码）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
      "args": [".", "--console", "--user-data-dir=${workspaceFolder}/.dev-user-data", "--remote-debugging-port=9222"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "env": { "DSHL_DEBUG_STOP": "1" },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      // 控制台渲染进程断点（wwwroot/app.js 等）；需先启动上面的「主进程 + 渲染进程调试」
      "name": "附加到控制台渲染进程（9222）",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/wwwroot",
      "urlFilter": "*wwwroot*",
      "timeout": 20000
    },
    {
      // 一键跑完整自检（临时 DSH_HOME + 3999 端口，不影响正在运行的服务）
      "name": "启动器：自检（selftest）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
      "args": [".", "--selftest"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
